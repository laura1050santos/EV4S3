[resource]
script = ExtResource("1")
titulo = "Vigia Residencial"
endereco = "https://vigia.local/residencias/lin-barde"
conteudo = "A família Lin Barde mantém a Vigia Residencial entre seus contatos de segurança da propriedade. O atendimento envolve orientações sobre controle de acesso e acompanhamento dos equipamentos de vigilância.

A autorização de visitantes e prestadores de serviço continua sob responsabilidade dos moradores. Um contato registrado na agenda da residência não substitui uma autorização de entrada.

Registros de ocorrências, imagens e listas de acesso são de consulta restrita ao contratante. Nenhum desses registros é disponibilizado nesta página pública."
estilo = 2
