[resource]
script = ExtResource("1")
titulo = "TecnoLar"
endereco = "https://tecnolar.local/atendimento-residencial"
conteudo = "A residência Lin Barde faz parte de nossa carteira de atendimento residencial. A família utiliza a TecnoLar como referência tanto para assistência aos computadores quanto para manutenção da rede da casa.

Os chamados de equipamentos e os chamados de conectividade são registrados separadamente, mesmo quando pertencem ao mesmo endereço. Por isso, nosso nome pode aparecer em mais de uma categoria na agenda de contatos.

Relatórios de atendimento e dados dos equipamentos são entregues ao responsável pela residência. Este site apresenta apenas informações gerais dos serviços."
estilo = 1
