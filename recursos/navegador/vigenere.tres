[gd_resource type="Resource" script_class="ArtigoNavegador" format=3]

[ext_resource type="Script" path="res://scripts/telaComp/artigo_navegador.gd" id="1_artigo"]

[resource]
script = ExtResource("1_artigo")
termos = PackedStringArray("Vigenère", "Vigenere", "Cifra de Vigenère", "Cifra de Vigenere", "Cifra polialfabética", "Cifra polialfabetica")
titulo = "Cifra de Vigenère: mensagens protegidas por uma palavra-chave"
endereco = "https://arquivo.local/criptografia/vigenere"
conteudo = "A Cifra de Vigenère é um método histórico de criptografia polialfabética. Ela utiliza uma palavra-chave para transformar as letras de uma mensagem.

A palavra-chave é repetida ao longo do texto. Cada letra da chave determina um deslocamento no alfabeto, fazendo com que uma mesma letra da mensagem possa ser cifrada de maneiras diferentes.

Para decifrar a mensagem, é necessário conhecer a palavra-chave e inverter esses deslocamentos. Saber o nome da cifra não basta para recuperar o conteúdo.

Em registros antigos, referências associadas ao documento podem indicar onde investigar a palavra-chave. Elas não fazem parte do nome do método.

Embora tenha importância histórica, a Cifra de Vigenère não oferece segurança adequada para proteger informações em sistemas modernos."
